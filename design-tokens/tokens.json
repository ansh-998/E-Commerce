    "hairline": "#E7E3D9",
    "border": "#E7E3D9",
    "borderSubtle": "#DCD7CC",
    "borderDark": "#292524",
    "accent": "#B08D57",
    "accentHover": "#967543",
    "accentLight": "#F7F3EB",
    "accentGlow": "rgba(176, 141, 87, 0.2)",
    "admin": {
      "sidebar": "#1C1917",
      "sidebarHover": "#292524",
      "sidebarActive": "#2A2725",
      "sidebarBorder": "rgba(231, 227, 217, 0.12)",
