      "info": "#2A4B6B",
      "infoLight": "#EBF2F8",
      "infoBorder": "#BFD3E6"
    }
  },
  "typography": {
    "fonts": {
      "display": "'Playfair Display', Georgia, serif",
      "serif": "'Playfair Display', Georgia, serif",
      "sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
    },
    "scale": {
      "display": { "fontSize": "3.5rem", "lineHeight": "1.1", "letterSpacing": "-0.02em" },
      "h1": { "fontSize": "2.25rem", "lineHeight": "1.2", "letterSpacing": "-0.015em" },
      "h2": { "fontSize": "1.75rem", "lineHeight": "1.25", "letterSpacing": "-0.01em" },
      "h3": { "fontSize": "1.375rem", "lineHeight": "1.3", "letterSpacing": "-0.005em" },
      "h4": { "fontSize": "1.125rem", "lineHeight": "1.4", "letterSpacing": "0em" },
      "h5": { "fontSize": "1rem", "lineHeight": "1.5", "letterSpacing": "0em" },
      "h6": { "fontSize": "0.875rem", "lineHeight": "1.5", "letterSpacing": "0.05em" },
      "body": { "fontSize": "0.9375rem", "lineHeight": "1.6", "letterSpacing": "0em" },
      "bodySm": { "fontSize": "0.875rem", "lineHeight": "1.5", "letterSpacing": "0.01em" },
      "caption": { "fontSize": "0.75rem", "lineHeight": "1.4", "letterSpacing": "0.05em" },
      "overline": { "fontSize": "0.6875rem", "lineHeight": "1.4", "letterSpacing": "0.2em" }
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "radii": {
    "none": "0px",
    "sm": "3px",
    "md": "6px",
    "lg": "10px",
    "xl": "16px",
    "full": "9999px"
  },
  "shadows": {
    "luxurySm": "0 1px 3px rgba(28, 25, 23, 0.04), 0 1px 2px rgba(28, 25, 23, 0.02)",
    "luxuryMd": "0 4px 16px -2px rgba(28, 25, 23, 0.06), 0 2px 6px -1px rgba(28, 25, 23, 0.03)",
    "luxuryLg": "0 12px 32px -4px rgba(28, 25, 23, 0.08), 0 4px 12px -2px rgba(28, 25, 23, 0.04)",
    "luxuryXl": "0 24px 48px -12px rgba(28, 25, 23, 0.12), 0 8px 24px -4px rgba(28, 25, 23, 0.06)"
  },
  "motion": {
    "easing": {
      "luxury": "cubic-bezier(0.16, 1, 0.3, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "easeOut": "cubic-bezier(0, 0, 0.2, 1)"
    },
    "duration": {
      "micro": "150ms",
      "ui": "250ms",
      "page": "350ms",
      "reveal": "800ms"
    }
  }
}
